[Unit]
Description=Visa Registration - FRRO Registration Server (Port 8082)
After=network.target mysql.service visareg-registry.service visareg-visa.service
Wants=visareg-registry.service visareg-visa.service

[Service]
User=azureuser
WorkingDirectory=/opt/visareg
EnvironmentFile=/opt/visareg/env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:+UseSerialGC -jar /opt/visareg/registration-server.jar
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
