# ====================================================================
# Visa Registration System — Environment Configuration Template
# Place at /opt/visareg/env on the Azure VM and run: chmod 600 /opt/visareg/env
# ====================================================================

# Database Configuration (MySQL 8 on localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visareg
DB_USERNAME=visareg
DB_PASSWORD=your_secure_db_password_here

# Service Registry Endpoint (SOAP discovery)
REGISTRY_URL=http://localhost:8080/ws

# Public host / IP of the Azure VM (e.g. 20.198.xxx.xxx)
# Used by services to publish their reachable endpoint to the Registry
APP_PUBLIC_HOST=your_azure_vm_public_ip

# External REST API Configuration
NOMINATIM_EMAIL=your_email@example.com
HOLIDAY_API_KEY=your_optional_calendarific_api_key

# Officer Default Initial Passwords (BCrypt seeded on first boot)
VISA_OFFICER_PASSWORD=password123
FRRO_OFFICER_PASSWORD=password123
